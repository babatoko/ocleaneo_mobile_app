VITE_API_URL=http://localhost:3000/api
# Instance Odoo confirmée : https://www.entretien-maconnais.fr/ — une fois le
# module base_rest installé et son chemin de base connu (ex. /api ou /fsm),
# pointer VITE_API_URL dessus (ex. https://www.entretien-maconnais.fr/api).
# Voir README.md § Intégration Odoo pour le contrat d'endpoints attendu.
# Ce n'est qu'une valeur par défaut : chaque utilisateur peut la surcharger à
# l'exécution depuis Profil > Paramètres > Serveur, sans reconstruire l'app.

# Provider de données actif : 'rest' (défaut, parle à VITE_API_URL) ou 'mock'
# (100% en mémoire, zéro backend — utile pour développer/faire une démo de
# l'app sans rien avoir à faire tourner). Voir frontend/src/providers/.
VITE_DATA_PROVIDER=rest
