VITE_API_URL=http://localhost:3000/api
# URL du backend REST (provider 'rest', défaut historique). Ce n'est qu'une
# valeur par défaut : chaque utilisateur peut la surcharger à l'exécution
# depuis Profil > Paramètres > Serveur, sans reconstruire l'app.

VITE_ODOO_API_URL=https://www.entretien-maconnais.fr/api/mobile
# URL du backend Odoo 14 (provider 'odoo' — voir odoo/README.md pour le
# détail des routes /api/mobile/*). Même mécanisme de surcharge à
# l'exécution que VITE_API_URL, depuis Profil > Paramètres > Serveur.

# Provider de données actif :
# - 'rest' (défaut) : parle à VITE_API_URL, contrat REST/JSON.
# - 'odoo' : parle à VITE_ODOO_API_URL, contrat JSON-RPC Odoo (voir
#   providers/OdooProvider.ts). Catalogue produits, inventaire et
#   commandes n'ont pas d'équivalent Odoo aujourd'hui (voir
#   odoo/README.md § Vérification) — ces écrans resteront en erreur avec
#   ce provider tant que ce périmètre n'est pas construit côté Odoo.
# - 'mock' : 100% en mémoire, zéro backend — utile pour développer/faire
#   une démo de l'app sans rien avoir à faire tourner.
# Voir frontend/src/providers/.
VITE_DATA_PROVIDER=rest
