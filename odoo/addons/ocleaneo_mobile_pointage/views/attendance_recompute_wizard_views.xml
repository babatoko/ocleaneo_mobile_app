<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ocleaneo_attendance_recompute_wizard_form" model="ir.ui.view">
        <field name="name">ocleaneo.attendance.recompute.wizard.form</field>
        <field name="model">ocleaneo.attendance.recompute.wizard</field>
        <field name="arch" type="xml">
            <form string="Recalcul de présence">
                <p>
                    Rejoue le journal de pointage mobile d'un salarié pour une
                    journée donnée et le compare aux présences réellement
                    enregistrées — un filet de rattrapage pour diagnostiquer
                    une journée suspecte, indépendant du calcul incrémental
                    qui tourne à chaque pointage.
                </p>
                <group>
                    <field name="employee_id"/>
                    <field name="date"/>
                    <field name="apply"/>
                </group>
                <field name="result" attrs="{'invisible': [('result', '=', False)]}" readonly="1"/>
                <footer>
                    <button name="action_run" type="object" string="Analyser" class="btn-primary"/>
                    <button string="Fermer" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ocleaneo_attendance_recompute_wizard" model="ir.actions.act_window">
        <field name="name">Recalcul de présence (journée suspecte)</field>
        <field name="res_model">ocleaneo.attendance.recompute.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_ocleaneo_attendance_recompute_wizard"
              name="Recalcul de présence"
              parent="hr_attendance.menu_hr_attendance_manage_attendances"
              action="action_ocleaneo_attendance_recompute_wizard"
              groups="hr_attendance.group_hr_attendance_manager"
              sequence="30"/>

</odoo>
