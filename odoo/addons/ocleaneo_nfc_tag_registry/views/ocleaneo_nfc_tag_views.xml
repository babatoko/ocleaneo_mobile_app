<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ocleaneo_nfc_tag_tree" model="ir.ui.view">
        <field name="name">ocleaneo.nfc.tag.tree</field>
        <field name="model">ocleaneo.nfc.tag</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="uid"/>
                <field name="location_id"/>
                <field name="partner_id"/>
                <field name="tag_type"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_ocleaneo_nfc_tag_form" model="ir.ui.view">
        <field name="name">ocleaneo.nfc.tag.form</field>
        <field name="model">ocleaneo.nfc.tag</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" string="Activate" type="object" states="draft" class="oe_highlight"/>
                    <button name="action_mark_lost" string="Mark Lost" type="object" states="active,draft"/>
                    <button name="action_disable" string="Disable" type="object" states="active,draft,lost"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="uid"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="location_id"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="tag_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notes..."/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activities"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_ocleaneo_nfc_tag_search" model="ir.ui.view">
        <field name="name">ocleaneo.nfc.tag.search</field>
        <field name="model">ocleaneo.nfc.tag</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="uid"/>
                <field name="location_id"/>
                <field name="partner_id"/>
                <field name="tag_type"/>
                <filter name="active" string="Active" domain="[('state','=','active')]"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="lost" string="Lost" domain="[('state','=','lost')]"/>
                <filter name="disabled" string="Disabled" domain="[('state','=','disabled')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_partner" string="Customer" context="{'group_by':'partner_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_tag_type" string="Tag Type" context="{'group_by':'tag_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_ocleaneo_nfc_tag_pivot" model="ir.ui.view">
        <field name="name">ocleaneo.nfc.tag.pivot</field>
        <field name="model">ocleaneo.nfc.tag</field>
        <field name="arch" type="xml">
            <pivot string="NFC Tags">
                <field name="partner_id" type="row"/>
                <field name="state" type="col"/>
                <field name="tag_type" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="action_ocleaneo_nfc_tag" model="ir.actions.act_window">
        <field name="name">NFC Tags</field>
        <field name="res_model">ocleaneo.nfc.tag</field>
        <field name="view_mode">tree,form,pivot</field>
        <field name="search_view_id" ref="view_ocleaneo_nfc_tag_search"/>
        <field name="help" type="html">
            <p>Create a registry entry for each NFC tag placed at a customer location.</p>
            <p>
                Utilisez les filtres « Regrouper par » (client, statut, type de tag) sur la
                liste, ou la vue pivot, pour obtenir un décompte par client, par statut ou
                par type de tag — imprimable ou exportable depuis Odoo (icônes en haut de la
                vue).
            </p>
        </field>
    </record>
</odoo>
