<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_partner_form_nfc_tags" model="ir.ui.view">
        <field name="name">res.partner.form.nfc.tags</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <!-- search_default_partner_id : le partner_id de l'action_ocleaneo_nfc_tag
                     partagée (liste + pivot) n'a pas de domaine propre à ce client — sans ce
                     préréglage de filtre, ce bouton ouvrirait le registre entier au lieu du
                     rapport de ce seul client. -->
                <button name="%(action_ocleaneo_nfc_tag)d" type="action" class="oe_stat_button" icon="fa-wifi" attrs="{'invisible': [('ocleaneo_nfc_tag_count', '=', 0)]}" context="{'search_default_partner_id': active_id}">
                    <field name="ocleaneo_nfc_tag_count" widget="statinfo" string="NFC Tags"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']" position="inside">
                <group string="NFC Tags">
                    <field name="ocleaneo_nfc_tag_ids" readonly="1" nolabel="1">
                        <tree>
                            <field name="name"/>
                            <field name="uid"/>
                            <field name="location_id"/>
                            <field name="tag_type"/>
                            <field name="state"/>
                        </tree>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
